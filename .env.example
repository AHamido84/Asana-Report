# ============================================================================
# Asana Executive Dashboard - Environment Configuration
# Copy this file to .env (or .env.local) and fill in real values.
# NEVER commit .env or .env.local to git.
# ============================================================================

# --- Required ---------------------------------------------------------------

# Asana Personal Access Token (server-side only, never exposed to the browser)
# Get one at: https://app.asana.com/0/my-apps  ->  "Create app" -> "Personal access token"
ASANA_ACCESS_TOKEN=2/1217986429184199/1218736796257201:efb5c6235330e3536c69251d6bccf31a

# The Asana Project GID that the dashboard reports on.
# Found in the project URL: https://app.asana.com/1/<workspace>/project/<PROJECT_GID>/...
ASANA_PROJECT_GID=1214079402325366

# --- Optional (auto-discovered from the API if omitted) ---------------------

# Asana Workspace GID. If left empty, the dashboard discovers it automatically
# from the project's `workspace` field on first sync.
ASANA_WORKSPACE_GID=

# The Board/Section context the project view was opened from. Not required for
# data fetching (sections are discovered dynamically), kept for reference/deep-links.
ASANA_BOARD_GID=1214079489238063

# --- Behavior configuration ---------------------------------------------------

# How long fetched Asana data stays cached server-side before a background
# refresh is triggered automatically, in seconds. Manual "Sync Now" always
# bypasses this. Default: 300 (5 minutes)
ASANA_CACHE_TTL_SECONDS=300

# Whether to fetch each task's attachment count from Asana. This drives the
# "Output Count" business rule (Outputs = attachments, or 1 if a task has
# none) used across KPIs, breakdowns, and exports. It costs one extra Asana
# API request per task (Asana has no bulk attachment-count field), so on a
# very large project you may set this to "false" to skip it — Output Count
# then falls back to 1 per task everywhere. Default: true
ASANA_FETCH_ATTACHMENTS=true

# Default dashboard language: "ar" or "en"
DASHBOARD_DEFAULT_LOCALE=en

# Default theme: "light" or "dark"
DASHBOARD_DEFAULT_THEME=light

# Display name shown in the dashboard header
DASHBOARD_TITLE="Executive Project Dashboard"

# Optional company name shown in the header/export
DASHBOARD_COMPANY_NAME=

# IANA timezone used for date calculations (due today, overdue, aging, etc.)
# Default: UTC
DASHBOARD_TIMEZONE=UTC
